# Ledivan+ — variáveis de ambiente (copie para .env.local e preencha)

# Banco Postgres (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth0 Configuration (migração 02/08/2026)
# Tenant: reverblabs.us.auth0.com
APP_BASE_URL="https://ledivan.com.br"  # ou http://localhost:3001 para desenvolvimento
AUTH0_DOMAIN="reverblabs.us.auth0.com"
AUTH0_CLIENT_ID=""  # Obter em Auth0 Dashboard > Applications > Ledivan > Settings
AUTH0_CLIENT_SECRET=""  # Obter em Auth0 Dashboard > Applications > Ledivan > Settings
AUTH0_SECRET=""  # Gerar com: openssl rand -base64 32

# Login por e-mail (Resend)
AUTH_RESEND_KEY=""

# IA (OpenAI) — scan de recibo + insights
OPENAI_API_KEY=""

# Telegram (bot via @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# WhatsApp via Evolution API (gateway open-source)
EVOLUTION_API_URL=""        # ex: https://evo.seuservidor.com
EVOLUTION_API_KEY=""        # apikey global ou da instância
EVOLUTION_INSTANCE=""       # nome da instância conectada ao número
EVOLUTION_WEBHOOK_TOKEN=""  # opcional: protege o webhook (?token=...)

# Cron de lembretes (Vercel injeta este Bearer automaticamente nas chamadas de cron)
CRON_SECRET=""

# Chave de criptografia (32 bytes em base64) p/ segredos por tenant (SMTP). Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Sistema imunológico da frota (defesa compartilhada). Vazio = no-op gracioso.
IMMUNE_HUB_URL=""
IMMUNE_TOKEN=""
IMMUNE_APP=""
