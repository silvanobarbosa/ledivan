# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Ignora QUALQUER .env e libera só os de exemplo. O padrao antigo (.env*.local + .env)
# deixava passar `.env.vercel`, `.env.production.vercel` e `.env.production` — que sao
# justamente os nomes que o `vercel env pull` cria. Foi por essa fresta que 40 chaves de
# producao do hub foram parar num repositorio publico em julho/2026.
.env*
!.env.example
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stitch assets
src/stitch/*
!src/stitch/tokens.json

# playwright mcp (snapshots/logs de sessão de navegador)
.playwright-mcp/

.vercel

# dados do consultório (não versionar)
Gi/
*.xlsx

# Python cache
__pycache__/
*.pyc

# capturas do harness visual (scripts/visual-*.mjs) — conferência local, nunca versionadas
_visual/

# Backups de limpeza: dado real de paciente, nunca versionado.
backups/

# Entrada crua dos documentos do dono (o PDF vai versionado dentro de docs/pedidos/NNN-*/)
docs/pedidos/_entrada/
